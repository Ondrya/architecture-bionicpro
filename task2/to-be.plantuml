@startuml
!include <C4/C4_Container>
!include <C4/C4_Context>

' Цвета
!define PERSON_BG #6C6477
!define PERSON_BORDER #4D4D4D
!define SYSTEM_BG #1061B0
!define SYSTEM_BORDER #0D5091
!define CONTAINER_BG #23A2D9
!define CONTAINER_BORDER #0E7DAD
!define EMPLOYEE_BG #083F75
!define EMPLOYEE_BORDER #06315C
!define ANALYTICS_BG #2E7D32
!define ANALYTICS_BORDER #1B5E20

' Внешние пользователи
Person(pilot, "Пилот протеза", "С этого человека считываются данные")
Person(buyer, "Покупатель протеза", "")

' Внешние программные системы
System(prosthesis, "Программа в чипе протеза", "C++", "Чтение данных с датчиков, распознавание движений и их воспроизводство")
System(mobile_app, "Приложение для донастройки протеза", "iOS, Android", "")

' Внешние IdP (региональные)
System(keycloak, "Keycloak (РФ)", "OIDC Provider", "Аутентификация пользователей в РФ")
System(foreign_idp, "Международный IdP", "OIDC Provider", "Для других стран")

' Сотрудники компании
Person(ml_engineer, "ML-инженер", "")
Person(operator, "Оператор производства", "")
Person(analyst, "Аналитик", "Просмотр отчётов")

' Граница системы BionicPRO
Boundary(bionicpro, "BionicPRO", "Software System") {
    ' Auth Gateway (BFF) - единая точка входа
    Container(auth_gateway, "Auth Gateway", "Spring Cloud Gateway / Node.js", "BFF-сервис: управление сессиями, проксирование запросов, хранение токенов в HTTP-only cookies")
    
    ' Сервис федерации пользователей
    Container(federation, "User Federation Service", "SpringBoot", "Синхронизация пользователей из IdP, хранение только reference-идентификаторов")
    
    ' Существующие контейнеры
    Container(api, "API", "SpringBoot", "Бизнес-логика + **доступ к отчётам**")
    ContainerDb(postgres, "База данных", "PostgreSQL", "Основное хранилище + **данные с датчиков**")
    Container(shop, "Интернет-магазин", "Битрикс24", "")
    Container(crm, "CRM", "Битрикс24", "")
    ContainerDb(crm_db, "CRM DB", "Oracle Database 12", "")
    Container(cli, "cli tool", "Python", "")
    
    ' === НОВЫЕ КОМПОНЕНТЫ ОТЧЁТНОСТИ ===
    Container(etl_orchestrator, "Apache Airflow", "Apache Airflow", "**ETL-оркестратор**: планирование и выполнение пайплайнов извлечения данных")
    ContainerDb(olap_db, "OLAP База данных", "ClickHouse / Apache Druid", "**Витрина отчётности**: агрегированные данные для аналитики")
}

' Связи аутентификации (безопасная схема с PKCE)
Rel(mobile_app, auth_gateway, "1. Аутентификация через OIDC с PKCE", "HTTPS")
Rel(auth_gateway, keycloak, "2. Authorization Code Flow", "HTTPS")
Rel(auth_gateway, foreign_idp, "2. Authorization Code Flow", "HTTPS")
Rel(auth_gateway, mobile_app, "3. Session cookie (HTTP-only)", "HTTPS")

' Внутренние связи (все через Auth Gateway)
Rel(auth_gateway, api, "Прокси-запросы с user context (из сессии)", "HTTP")
Rel(auth_gateway, shop, "Прокси-запросы", "HTTP")
Rel(auth_gateway, federation, "Создание/обновление пользователя", "HTTP")

' Federation Service синхронизирует данные
Rel(federation, postgres, "Сохранение reference ID (без ПДн)", "SQL")
Rel(federation, keycloak, "Запрос информации о пользователе", "HTTPS")
Rel(federation, foreign_idp, "Запрос информации о пользователе", "HTTPS")

' Существующие связи
Rel(api, postgres, "CRUD", "SQL")
Rel(shop, crm, "Передача данных заказа", "")
Rel(crm, crm_db, "CRUD", "SQL")

' Связи с протезом
Rel(pilot, prosthesis, "Предоставление миосигналов")
Rel(mobile_app, prosthesis, "Управление протезом", "Bluetooth")
Rel(prosthesis, api, "Отправка технической телеметрии", "4G")
Rel(prosthesis, mobile_app, "Передача статуса", "Bluetooth")

' Работа сотрудников
Rel(ml_engineer, cli, "Запуск выгрузки", "")
Rel(cli, postgres, "Выгрузка данных для ML", "SQL")
Rel(operator, crm, "Ведение производства", "")

' Связь покупателя
Rel(buyer, shop, "Выбор протеза, заказ, оплата", "HTTPS")

' === НОВЫЕ СВЯЗИ ETL И ОТЧЁТНОСТИ ===
Rel(postgres, etl_orchestrator, "Извлечение данных с датчиков", "SQL / API")
Rel(crm_db, etl_orchestrator, "Извлечение данных о клиентах и заказах", "SQL")
Rel(etl_orchestrator, olap_db, "Трансформация и загрузка агрегированных данных", "SQL")
Rel(api, olap_db, "Запросы для формирования отчётов по пользователю", "SQL")
Rel(analyst, api, "Получение отчётов через API", "HTTPS")

' Документирование ETL-процесса
'Rel_Note(etl_orchestrator, "ETL-процесс:\n1. Извлечение из PostgreSQL (датчики)\n2. Извлечение из Oracle CRM (заказы)\n3. Трансформация и объединение\n4. Загрузка в OLAP витрину\n5. Расписание: ежедневно/почасово", "bottom")

@enduml